{
  "name": "@living-network/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "dev": "node src/main.ts",
    "start": "node src/main.ts",
    "start:postgres": "node src/persistent-main.ts",
    "migrate:postgres": "node src/migrate.ts",
    "seed:postgres": "node src/seed.ts",
    "bootstrap:postgres": "node src/migrate.ts && node src/seed.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node ../../scripts/run-tests.mjs src",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@living-network/ai": "workspace:*",
    "@living-network/config": "workspace:*",
    "@living-network/contracts": "workspace:*",
    "@living-network/database": "workspace:*",
    "@living-network/domain": "workspace:*",
    "@living-network/ports": "workspace:*",
    "fastify": "^5.11.3"
  }
}
