{
  "schemaVersion": 1,
  "unownedPolicy": "deny",
  "activeRuntimePaths": [
    "apps/api/src/v2/**",
    "apps/web/src/v2/**",
    "apps/worker/src/v2/**",
    "packages/ai/src/v2*.ts",
    "packages/config/src/v2*.ts",
    "packages/contracts/src/v2/**",
    "packages/database/src/v2/**",
    "packages/domain/src/v2/**",
    "packages/ports/src/v2/**"
  ],
  "legacyReadOnlyRoots": [
    "apps/**",
    "packages/**"
  ],
  "delegatedPaths": [
    "docs/interface-requests/**"
  ],
  "protectedPaths": [
    ".ai/**",
    ".github/**",
    "AGENTS.md",
    "apps/AGENTS.md",
    "packages/AGENTS.md",
    "docs/**",
    "scripts/**",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "tsconfig*.json",
    "apps/*/package.json",
    "packages/*/package.json",
    "infra/**"
  ],
  "highRiskPaths": [
    "packages/database/src/v2/**/migrations.ts",
    "apps/api/src/v2/platform/plugin.ts",
    "apps/api/src/v2/platform/runtime.ts",
    "apps/worker/src/v2/model-provider.ts",
    "packages/database/src/v2/platform/repository.ts",
    "packages/ports/src/v2/platform/index.ts"
  ],
  "modules": {
    "core": {
      "description": "Canon, graph/state, review, release and play runtime",
      "allowedDependencies": [
        "core",
        "integration"
      ],
      "ownedPaths": [
        "apps/api/src/v2/core/**",
        "packages/contracts/src/v2/core/**",
        "packages/domain/src/v2/core/**",
        "packages/ports/src/v2/core/**",
        "packages/database/src/v2/core/*-repository.ts",
        "packages/database/src/v2/core/*-repository.test.ts"
      ]
    },
    "generation-assets": {
      "description": "Generation jobs, candidates, assets and external generation adapters",
      "allowedDependencies": [
        "generation-assets",
        "integration"
      ],
      "ownedPaths": [
        "apps/api/src/v2/generation/**",
        "apps/worker/src/v2/asset-generation-worker*.ts",
        "apps/worker/src/v2/dynamic-comfyui-client.ts",
        "apps/worker/src/v2/generation-dispatch-pump*.ts",
        "apps/worker/src/v2/local-asset-media-store*.ts",
        "apps/worker/src/v2/model-provider*.ts",
        "apps/worker/src/v2/scene-generation-worker*.ts",
        "packages/ai/src/v2*.ts",
        "packages/contracts/src/v2/generation/**",
        "packages/domain/src/v2/generation/**",
        "packages/ports/src/v2/generation/**",
        "packages/database/src/v2/generation/*repository*.ts"
      ]
    },
    "platform": {
      "description": "Model profiles, capability bindings, appearance settings and model-call diagnostics",
      "allowedDependencies": [
        "platform",
        "integration"
      ],
      "ownedPaths": [
        "apps/web/src/v2/views/V2AppearanceSettingsView.vue",
        "apps/web/src/v2/views/platform.ts",
        "packages/ports/src/v2/platform/**",
        "packages/database/src/v2/platform/repository*.ts"
      ]
    },
    "web-shell": {
      "description": "V2 navigation, layout, theme shell and non-business placeholders",
      "allowedDependencies": [
        "web-shell",
        "integration"
      ],
      "ownedPaths": [
        "apps/web/src/v2/components/V2StatusRail.vue",
        "apps/web/src/v2/sentinel.test.ts",
        "apps/web/src/v2/views/V2SettingsHomeView.vue"
      ]
    },
    "integration": {
      "description": "Composition roots, shared contracts, migrations, mixed hotspots and repository governance",
      "allowedDependencies": [
        "core",
        "generation-assets",
        "platform",
        "web-shell",
        "integration"
      ],
      "ownedPaths": [
        ".ai/**",
        ".github/**",
        "AGENTS.md",
        "apps/*/package.json",
        "apps/AGENTS.md",
        "apps/api/src/v2/index.ts",
        "apps/api/src/v2/main.ts",
        "apps/api/src/v2/platform/app.ts",
        "apps/api/src/v2/platform/health.test.ts",
        "apps/api/src/v2/platform/index.ts",
        "apps/api/src/v2/platform/plugin*.ts",
        "apps/api/src/v2/platform/runtime*.ts",
        "apps/web/src/v2/V2Shell.vue",
        "apps/web/src/v2/adapters/adapter.test.ts",
        "apps/web/src/v2/adapters/http.ts",
        "apps/web/src/v2/adapters/index.ts",
        "apps/web/src/v2/adapters/mock.ts",
        "apps/web/src/v2/adapters/platform*.ts",
        "apps/web/src/v2/adapters/types.ts",
        "apps/web/src/v2/components/V2ToastNotification.vue",
        "apps/web/src/v2/components/V2WorkspacePanel.vue",
        "apps/web/src/v2/components/workspace/**",
        "apps/web/src/v2/fixtures/**",
        "apps/web/src/v2/index.ts",
        "apps/web/src/v2/stores/**",
        "apps/web/src/v2/views/V2ModelSettingsView.vue",
        "apps/web/src/v2/views/V2WorkspaceAreaView.vue",
        "apps/worker/src/v2/index.ts",
        "apps/worker/src/v2/runtime.ts",
        "apps/worker/src/v2/sentinel.test.ts",
        "docs/**",
        "infra/**",
        "package.json",
        "packages/*/package.json",
        "packages/AGENTS.md",
        "packages/config/src/v2*.ts",
        "packages/contracts/src/v2/fixtures/**",
        "packages/contracts/src/v2/index.ts",
        "packages/contracts/src/v2/platform/**",
        "packages/contracts/src/v2/shared/**",
        "packages/database/src/v2/core/index.ts",
        "packages/database/src/v2/core/migrations.ts",
        "packages/database/src/v2/generation/index.ts",
        "packages/database/src/v2/generation/migrations.ts",
        "packages/database/src/v2/index.ts",
        "packages/database/src/v2/platform/connection.ts",
        "packages/database/src/v2/platform/index.ts",
        "packages/database/src/v2/platform/migrations.ts",
        "packages/database/src/v2/platform/sqlite.test.ts",
        "packages/database/src/v2/platform/testing.ts",
        "packages/domain/src/v2/index.ts",
        "packages/domain/src/v2/shared/**",
        "packages/ports/src/v2/index.ts",
        "packages/ports/src/v2/shared/**",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "scripts/**",
        "tsconfig*.json",
        "apps/web/src/v2/views/V2ImageSettingsView.vue",
        "apps/web/src/v2/views/V2ModelLogsView.vue",
        "apps/web/src/v2/views/V2AutomationView.vue"
      ]
    }
  }
}