NODE_ENV=development

# V2 is the only active application runtime.
V2_API_HOST=127.0.0.1
V2_API_PORT=3003
V2_SQLITE_PATH=.data/living-network-v2.sqlite
V2_MEDIA_ROOT=./data/media

# Redis is queue-only and may be disabled for offline editing/playback.
REDIS_URL=redis://127.0.0.1:6379
V2_QUEUE_PREFIX=living-network-v2
V2_DISPATCH_TICK_MS=1000

# External lanes are opt-in. Keep disabled for local core development.
V2_SCENE_GENERATION_ENABLED=false
V2_ASSET_GENERATION_ENABLED=false
# Base64-encoded 32-byte key used to encrypt model API keys saved in V2 settings.
INTEGRATION_SECRET_KEY=
V2_LLM_PROTOCOL=openai-compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=30000
COMFYUI_BASE_URL=
COMFYUI_TIMEOUT_MS=30000

# Web mock mode is opt-in and intended for UI-only development.
VITE_V2_ENABLE_MOCK=false
