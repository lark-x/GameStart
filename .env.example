NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
DATABASE_URL=postgresql://living_network:living_network_dev_only@127.0.0.1:5432/living_network
REDIS_URL=redis://127.0.0.1:6379
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT_MS=30000
MEDIA_ROOT=./data/media

# Optional LLM provider settings.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional real-service acceptance switches (keep disabled for local unit tests).
RUN_LLM_ACCEPTANCE=0
RUN_COMFYUI_ACCEPTANCE=0
COMFYUI_WORKFLOW_FILE=
COMFYUI_WORKFLOW_JSON=
COMFYUI_MAX_ATTEMPTS=30
COMFYUI_POLL_DELAY_MS=2000
COMFYUI_PROGRESS_ACCEPTANCE=0
COMFYUI_PROGRESS_TIMEOUT_MS=120000

# Local Compose credentials; change them before sharing or deploying.
POSTGRES_DB=living_network
POSTGRES_USER=living_network
POSTGRES_PASSWORD=living_network_dev_only
MINIO_ROOT_USER=living_network
MINIO_ROOT_PASSWORD=living_network_dev_only
